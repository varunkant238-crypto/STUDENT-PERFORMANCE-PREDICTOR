# Student Performance Predictor Environment Configuration
# Copy this file to .env and customize with your local parameters

# Flask Secret Key
SECRET_KEY=college_mini_project_secure_flask_secret_key_2026

# Database Settings (MySQL)
DB_ENGINE=mysql
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_predictor_db

# Optional fallback database URI (if MySQL is unavailable, application uses SQLite)
SQLITE_FALLBACK=True

# Initial Administrator Account Setup (Seeded on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword@2026
ADMIN_EMAIL=admin@college.edu
ADMIN_FULL_NAME=System Administrator
